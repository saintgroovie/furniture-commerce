+/** Catalog cards need multipliers, not marketing prose. */
+function slimMaterialTiers(value: unknown): unknown {
+  if (value == null || typeof value !== "object" || Array.isArray(value)) {
+    return value
+  }
+  const out: Record<string, unknown> = {}
+  for (const [code, entry] of Object.entries(value as Record<string, unknown>)) {
+    if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
+      out[code] = entry
+      continue
+    }
+    const e = entry as Record<string, unknown>
+    const slim: Record<string, unknown> = {}
+    if (typeof e.key === "string") slim.key = e.key
+    if (typeof e.label_ru === "string") slim.label_ru = e.label_ru
+    if (typeof e.price_multiplier === "number") slim.price_multiplier = e.price_multiplier
+    if (typeof e.position === "number") slim.position = e.position
+    out[code] = slim
+  }
+  return out
+}
+
+/** Card/sale price reads only these two numbers. */
+function slimBuyerDefaultConfiguration(value: unknown): unknown {
+  if (value == null || typeof value !== "object" || Array.isArray(value)) {
+    return value
+  }
+  const e = value as Record<string, unknown>
+  const slim: Record<string, unknown> = {}
+  if (typeof e.min_unit_price === "number") slim.min_unit_price = e.min_unit_price
+  if (typeof e.original_min_unit_price === "number") {
+    slim.original_min_unit_price = e.original_min_unit_price
+  }
+  return slim
+}
