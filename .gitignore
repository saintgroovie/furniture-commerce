.DS_Store
node_modules/
.env
.env.local
*.log
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.medusa/
.yarn/
*.tsbuildinfo

# --- Layer A: pipeline + runtime assets (onboarding: docs/project/repo-onboarding-and-assets-runbook.md) ---

# Raw inputs (PDF/PNG/HTML/scrape/workbook parse); obtain via archive or rerun ingestion — not app source
# Use /data/raw/* (not /data/raw/) so a negated subtree can be tracked (see docs/project/workbook-local-source-contract.md).
/data/raw/*
!/data/raw/workbook/
data/raw/workbook/*.json
!/data/raw/workbook/source/
data/raw/workbook/source/*.xlsx
data/raw/workbook/source/*.xlsm
data/raw/workbook/source/*.xls

# Preprocessed images (output of preprocess scripts; source is raw + manifests)
/data/processed/storefront-assets/**
!/data/processed/storefront-assets/.gitkeep

# Materialized catalog images for Medusa (regenerate after clone)
/apps/backend/static/products/**
!/apps/backend/static/products/.gitkeep
/apps/backend/uploads/products/**
!/apps/backend/uploads/products/.gitkeep

# Per-machine upload run logs (regenerated by scripts/upload-assets-to-local-storage.py)
/data/processed/asset-manifests/local-upload-status.json
/data/processed/asset-manifests/local-upload-failures.json
/data/processed/asset-manifests/local-upload-summary.json
