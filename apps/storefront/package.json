{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --port 3002",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "build:qa": "bash scripts/qa-rebuild.sh",
    "sync:qa-build-marker": "node scripts/sync-qa-build-marker.mjs",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "check:landing-css": "node scripts/check-landing-css-assets.mjs",
    "check:landing-css:heal": "node scripts/check-landing-css-assets.mjs --heal",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.production.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "test:fidelity": "node scripts/run-fidelity-tests.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "typescript": "^5.0.0"
  }
}
