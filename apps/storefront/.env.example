# Backend URL for browser requests
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Backend URL for server-side requests (SSR, middleware)
# In Docker: http://medusa:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API Key (get from Admin → Settings → Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Catalog/RoomSet membership read TTL for medusaCatalogFetch (seconds).
# Default 60. Set 0 to force no-store (debug / stale-price bypass).
# Cart, checkout, mutations, and PDP detail stay on medusaFetch no-store.
# MEDUSA_CATALOG_REVALIDATE_SECONDS=60

# Site URL (for SEO / OG metadataBase). Demo: https://woodright-demo.ru
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Indexing policy (server-only). Demo/staging: noindex.
# Allowed: noindex | index. Empty/unknown → noindex (fail-closed).
# Do not enable index on woodright-demo.ru. Production cutover = separate release.
# Never use NEXT_PUBLIC_* for this decision.
WOODRIGHT_INDEXING_MODE=noindex

# Catalog card WebP derivatives (H4). Default 0.
# Set to 1 only after: generate → deploy derivatives to Medusa static →
# `tsx scripts/h4-coverage-gate.ts --http` exit 0 on that host.
# Runbook: docs/operator/catalog-card-derivatives-release.md
NEXT_PUBLIC_CATALOG_CARD_DERIVATIVES=0
