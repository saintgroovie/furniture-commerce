# Backend URL for browser requests
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Backend URL for server-side requests (SSR, middleware)
# In Docker: http://medusa:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API Key (get from Admin → Settings → Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Site URL (for SEO, canonical, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Catalog card WebP derivatives (H4). Default 0.
# Set to 1 only after: generate → deploy derivatives to Medusa static →
# `tsx scripts/h4-coverage-gate.ts --http` exit 0 on that host.
# Runbook: docs/operator/catalog-card-derivatives-release.md
NEXT_PUBLIC_CATALOG_CARD_DERIVATIVES=0
