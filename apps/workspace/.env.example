# Server-only. Never put these in NEXT_PUBLIC_*.
MEDUSA_BACKEND_INTERNAL_URL=http://127.0.0.1:9000

# Comma-separated staff emails allowed to open Medusa. Empty hides the hatch for everyone.
WOODRIGHT_WORKSPACE_OWNER_EMAILS=

# Loopback fallback only. admin.woodright.ru is refused.
WOODRIGHT_MEDUSA_ADMIN_URL=http://127.0.0.1:9000/app

# Local screenshot preview. Both must be set, and never in production compose.
# WOODRIGHT_WORKSPACE_FIXTURES=1
# WOODRIGHT_WORKSPACE_RUNTIME=local-preview
