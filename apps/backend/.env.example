# Database (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/furniture_commerce

# JWT (required for admin auth)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin CORS (comma-separated origins)
ADMIN_CORS=http://localhost:7001,http://localhost:9000

# Store CORS (for Next.js storefront)
STORE_CORS=http://localhost:3000

# Medusa base URL (for links in emails etc.)
MEDUSA_BACKEND_URL=http://localhost:9000
