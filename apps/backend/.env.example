# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store

# Redis
REDIS_URL=redis://localhost:6379

# JWT / cookies (min 32 chars in real env)
JWT_SECRET=your-super-secret-jwt-key-min-32
COOKIE_SECRET=your-super-secret-cookie-key-min-32

# Store CORS (hybrid storefront :3002; Docker full profile host :8000)
STORE_CORS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000,http://127.0.0.1:8000

# Admin CORS
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:9000

# Auth CORS - include 127.0.0.1 admin origins or browser login loops on /app
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:9000

# Medusa base URL (scripts / absolute asset helpers). Embedded Admin ignores this
# locally and uses same-origin (see medusa-config admin.backendUrl) so login works
# on both http://localhost:9000 and http://127.0.0.1:9000.
MEDUSA_BACKEND_URL=http://localhost:9000
# Optional override for Admin SDK base URL. Empty = same-origin (recommended locally).
# ADMIN_BACKEND_URL=

# Set to 1 for local http:// (required for admin login with `yarn start` on localhost)
MEDUSA_LOCAL_HTTP=1

# Admin UI default language (cookie/localStorage `lng`); ru = Russian
ADMIN_DEFAULT_LOCALE=ru

# Buyer-facing origin for Woodright Admin preview links.
# Empty = local QA fallback http://localhost:3002 (dev only, not production canonical).
WOODRIGHT_SITE_URL=
