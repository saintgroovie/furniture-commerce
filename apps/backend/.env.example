# Database (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store

# Redis
REDIS_URL=redis://localhost:6379

# JWT (required for admin auth, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Cookie secret (min 32 chars)
COOKIE_SECRET=your-super-secret-cookie-key-min-32

# Store CORS (storefront origins)
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000

# Admin CORS
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:9000

# Auth CORS
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000,http://127.0.0.1:8000,http://127.0.0.1:9000

# Medusa base URL
MEDUSA_BACKEND_URL=http://localhost:9000
