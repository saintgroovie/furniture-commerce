# Database (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store

# Redis
REDIS_URL=redis://localhost:6379

# JWT (required for admin auth, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Cookie secret (min 32 chars)
COOKIE_SECRET=your-super-secret-cookie-key-min-32

# Store CORS (storefront origins)
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000

# Admin CORS (merged in medusa-config.ts with PORT / ADMIN_VITE_PORT origins)
ADMIN_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000,http://127.0.0.1:9000,http://localhost:9001,http://127.0.0.1:9001,http://localhost:5174,http://127.0.0.1:5174

# Auth CORS — include 127.0.0.1:5173 or browser login loops on /app
AUTH_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:9000,http://127.0.0.1:9000,http://localhost:9001,http://127.0.0.1:9001,http://localhost:5174,http://127.0.0.1:5174

# Medusa base URL
MEDUSA_BACKEND_URL=http://localhost:9000

# Set to 1 for local http:// (required for admin login with `npm run start` on localhost)
MEDUSA_LOCAL_HTTP=1

# Admin UI default language (cookie/localStorage `lng`); ru = Russian
ADMIN_DEFAULT_LOCALE=ru

# Admin Vite HMR: off by default (stable UI, no reload loop). Set to 1 only when editing src/admin.
# ADMIN_VITE_HMR=1

# Backend file changes reload without full server restart (set in npm run dev)
# MEDUSA_FF_BACKEND_HMR=true

# Local admin bootstrap (optional; for npm run ensure-local-admin)
# LOCAL_ADMIN_EMAIL=admin@woodright.ru
# LOCAL_ADMIN_PASSWORD=admin123
