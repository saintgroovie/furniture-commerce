{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "medusa-config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".medusa",
    "coverage",
    "uploads",
    "static",
    "tmp",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/scripts/**"
  ]
}
