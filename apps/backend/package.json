{
  "name": "furniture-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa backend for furniture ecommerce + bespoke",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:generate": "medusa db:generate",
    "db:migrate": "medusa db:migrate",
    "db:sync-links": "medusa db:sync-links",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "postinstall": "node scripts/patch-skip-cart-promotions.mjs && node scripts/patch-medusa-develop-watch.mjs --warn-only",
    "generate:catalog-card-derivatives": "tsx scripts/generate-catalog-card-derivatives.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@medusajs/cli": "2.18.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
