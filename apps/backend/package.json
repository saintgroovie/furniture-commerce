{
  "name": "furniture-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa backend for furniture ecommerce + bespoke",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:generate": "medusa db:generate",
    "db:migrate": "medusa db:migrate",
    "db:sync-links": "medusa db:sync-links",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "refresh-greenwich": "medusa exec ./src/scripts/refresh-greenwich.ts",
    "refresh-oliver": "medusa exec ./src/scripts/refresh-oliver.ts",
    "refresh-oliver-media": "medusa exec ./src/scripts/refresh-oliver-media.ts",
    "refresh-oliver-thumbnails": "medusa exec ./src/scripts/refresh-oliver-thumbnails.ts",
    "sync-oliver-primary-images": "medusa exec ./src/scripts/sync-oliver-primary-images.ts",
    "apply-oliver-kids-manifest": "medusa exec ./src/scripts/apply-oliver-kids-manifest.ts",
    "mvp-media-assignments": "medusa exec ./src/scripts/apply-mvp-media-assignments.ts",
    "oxford-pilot-four:materialize-static": "node ./scripts/oxford-pilot-four-materialize-static.mjs",
    "oxford-pilot-four:smoke": "node ./scripts/oxford-pilot-four-smoke.mjs",
    "oxford-pilot-four:seed": "medusa exec ./src/scripts/seed-oxford-pilot-four.ts",
    "oxford-pilot-four:validate-post-ingestion": "medusa exec ./src/scripts/validate-oxford-pilot-four-post-ingestion.ts",
    "oxford-pilot-four:sync-ingested-evidence": "node ./scripts/oxford-pilot-four-sync-ingested-evidence.mjs"
  },
  "dependencies": {
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
