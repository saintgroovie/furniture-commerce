    "refresh-greenwich": "medusa exec ./src/scripts/refresh-greenwich.ts"
  },
  "dependencies": {
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
