      "Archive this manifest revision in git with the mutation ticket / PR reference."
    ],
    "post_validate_sql_suggestions": [
      "SELECT count(*) FROM product WHERE deleted_at IS NULL AND metadata->>'collection' = 'oliver-kids';",
      "SELECT handle FROM product WHERE deleted_at IS NULL AND metadata->>'collection' = 'oliver' ORDER BY handle;"
    ]
